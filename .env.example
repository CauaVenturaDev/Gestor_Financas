# Supabase
# Onde achar: botão "Connect" no topo do painel > App Frameworks > Next.js.
# Ou em Settings > Data API (Project URL) e Settings > API Keys (Publishable key).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Aceita os dois formatos de chave pública:
#   formato novo:  sb_publishable_...
#   formato antigo: a "anon public" (um JWT começando com eyJ...)
# Essa chave é segura no navegador porque a RLS está ligada em todas as tabelas.
# A chave "secret" (sb_secret_...) e a antiga "service_role" NÃO são usadas pelo
# app e nunca devem entrar numa variável NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# URL pública do app, usada nos links de e-mail (confirmação e recuperação).
# Em produção na Vercel pode ficar de fora: o domínio é detectado sozinho.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
